# API Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Set to 'mongodb' to use a live MongoDB, or 'local' to use a local JSON file store (perfect for fast local testing)
DB_TYPE=local
MONGODB_URL=mongodb://localhost:27017
DB_NAME=recruitment_fraud_db

# NLP & ML Service Configuration
# Similarity threshold for semantic skill mapping (0.0 to 1.0)
SKILL_SIMILARITY_THRESHOLD=0.75
# spaCy Model Name
SPACY_MODEL=en_core_web_sm
# Sentence Transformer Model Name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
